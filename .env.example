# Actual Budget Connection
ACTUAL_SERVER_URL=https://your-actual-budget-server.com
ACTUAL_SERVER_PASSWORD=your-server-password
ACTUAL_SYNC_ID=your-budget-sync-id
ACTUAL_BUDGET_PASSWORD=your-encryption-password

# Account & Group
ACTUAL_ACCOUNT_ID=your-account-id
ACTUAL_GROUP_NAME="Импорт из Сбера"

# Server Settings
PORT=3000
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=0
# Optional: Set an API key to protect the /upload endpoint (Header: X-API-Key)
API_KEY=
